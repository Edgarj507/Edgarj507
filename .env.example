# Client (bundled into the app — public by design, protected by Row-Level Security).
# Copy to .env.local. Never put server secrets behind a VITE_ prefix; the build refuses.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Satellite imagery for the HUD. Mapbox *public* token (pk.…) → Mapbox Satellite.
# Without it the HUD uses Esri World Imagery. VITE_MAP_PROVIDER=none disables imagery.
# VITE_MAPBOX_TOKEN=pk.your-public-token
# VITE_MAP_PROVIDER=esri
